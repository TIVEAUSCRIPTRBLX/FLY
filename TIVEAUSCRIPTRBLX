local function createToggle(label, hint, callback)
	local row = card(46)

	new("TextLabel", {
		Size = UDim2.new(1, -80, 0, 20),
		Position = UDim2.fromOffset(14, 5),
		BackgroundTransparency = 1,
		Text = label,
		TextColor3 = THEME.text,
		Font = Enum.Font.GothamBold,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, row)

	new("TextLabel", {
		Size = UDim2.new(1, -80, 0, 14),
		Position = UDim2.fromOffset(14, 25),
		BackgroundTransparency = 1,
		Text = hint,
		TextColor3 = THEME.sub,
		Font = Enum.Font.Gotham,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, row)

	local track = new("Frame", {
		Size = UDim2.fromOffset(44, 24),
		Position = UDim2.new(1, -58, 0.5, -12),
		BackgroundColor3 = THEME.off,
		BorderSizePixel = 0,
	}, row)
	corner(track, 12)

	local knob = new("Frame", {
		Size = UDim2.fromOffset(18, 18),
		Position = UDim2.fromOffset(3, 3),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
	}, track)
	corner(knob, 9)

	local click = new("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
	}, row)

	local on = false
	local obj = {}

	function obj.Set(value, silent)
		on = value and true or false
		tween(track, 0.18, { BackgroundColor3 = on and THEME.accent or THEME.off })
		tween(knob, 0.18, { Position = on and UDim2.fromOffset(23, 3) or UDim2.fromOffset(3, 3) })
		if not silent then
			callback(on)
		end
	end

	function obj.Get()
		return on
	end

	click.MouseButton1Click:Connect(function()
		obj.Set(not on)
	end)

	return obj
end

