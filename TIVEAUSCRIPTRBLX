-- TOUCHES + RESPAWN
---------------------------------------------------------------------
addConn(UserInputService.InputBegan:Connect(function(input, processed)
	if processed then return end

	if input.KeyCode == Enum.KeyCode.F then
		flyToggle.Set(not flyToggle.Get())
	elseif input.KeyCode == Enum.KeyCode.N then
		noclipToggle.Set(not noclipToggle.Get())
	elseif input.KeyCode == Enum.KeyCode.M then
		setMenuVisible(not Frame.Visible)
	end
end))

addConn(Player.CharacterAdded:Connect(function()
	stopFly()
	originalCollide = {}
	setNoclip(false)
end))

---------------------------------------------------------------------
-- NETTOYAGE (si le script est relancé)
---------------------------------------------------------------------
_G.TiveauFlyUnload = function()
	stopFly()
	setNoclip(false)
	for _, c in ipairs(connections) do
		pcall(function() c:Disconnect() end)
	end
	if Gui then Gui:Destroy() end
	_G.TiveauFlyUnload = nil
end

