local function setSpeed(value)
	flySpeed = math.clamp(math.floor(value + 0.5), MIN_SPEED, MAX_SPEED)
	local rel = (flySpeed - MIN_SPEED) / (MAX_SPEED - MIN_SPEED)
	fill.Size = UDim2.fromScale(rel, 1)
	sliderKnob.Position = UDim2.new(rel, -8, 0.5, -8)
	valueLabel.Text = tostring(flySpeed)
end
setSpeed(flySpeed)

local function speedFromX(x)
	local rel = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
	setSpeed(MIN_SPEED + (MAX_SPEED - MIN_SPEED) * rel)
end

local sliding = false
